# Identifies us to OpenAlex/Crossref for their faster "polite pool".
CONTACT_EMAIL=you@example.com

# Optional: raises NCBI E-utilities from 3 to 10 requests/second.
# https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Elasticsearch (candidate retrieval for fuzzy matching, cohort search).
# Either a Cloud ID or an endpoint URL works; a URL pasted into the Cloud ID
# slot is accepted too.
ELASTIC_CLOUD_ID=
ELASTIC_URL=
ELASTIC_API_KEY=

# OpenAI, used for two language tasks only: reading hazard ratios out of
# sentences, and judging whether an abstract describes a given registration.
# Both spellings of the key name are accepted.
OPENAI_API_KEY=
# Cascade tiers: the small model answers first; the larger one is consulted only
# when the small one's answer fails validation.
LLM_MODEL_SMALL=gpt-4.1-nano
LLM_MODEL_LARGE=gpt-4.1-mini
# Hard cap on uncached model calls per process. Refuses rather than overspends.
LLM_MAX_CALLS=300

# Set to 0 to bypass the on-disk response cache.
PROVENANCE_USE_CACHE=1
